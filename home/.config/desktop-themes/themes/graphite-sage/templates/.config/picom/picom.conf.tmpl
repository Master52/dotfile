backend = "glx";
vsync = true;
use-damage = true;
shadow = true;
shadow-radius = 22;
shadow-opacity = 0.22;
shadow-offset-x = -8;
shadow-offset-y = -8;
corner-radius = 10;
fading = true;
fade-in-step = 0.07;
fade-out-step = 0.07;
fade-delta = 8;
shadow-exclude = [ "window_type = 'dock'", "window_type = 'desktop'", "_GTK_FRAME_EXTENTS@" ];
rounded-corners-exclude = [ "window_type = 'dock'", "window_type = 'desktop'" ];
blur-method = "dual_kawase";
blur-strength = 4;
blur-background = true;
blur-background-frame = false;
blur-background-exclude = [ "window_type = 'desktop'" ];
unredir-if-possible = true;

# Only supporting desktop surfaces receive compositor opacity; media stays opaque.
opacity-rule = [
 "100:class_g = 'Thunar'",
 "98:class_g = 'Dunst'",
 "98:class_g = 'dmenu'"
];
