#!/usr/bin/python3
"""Print Screen menu with full-screen, active-window and dragged-area capture."""
import datetime
import json
from pathlib import Path
import shutil
import subprocess
import sys
import time
import cairo

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
gi.require_version('GdkX11', '3.0')
from gi.repository import Gtk, Gdk, GdkX11

HOME = Path.home()


def rectangle(start, end, width, height):
    x1, x2 = sorted((max(0, min(width, start[0])), max(0, min(width, end[0]))))
    y1, y2 = sorted((max(0, min(height, start[1])), max(0, min(height, end[1]))))
    return int(x1), int(y1), int(x2 - x1), int(y2 - y1)


def visible_window_ids(state):
    visible = set()
    def visit(node):
        if not node:
            return
        if node.get('client') and not node.get('hidden') and node['client'].get('shown', True):
            visible.add(node['id'])
        visit(node.get('firstChild'))
        visit(node.get('secondChild'))
    for monitor in state['monitors']:
        for desktop in monitor['desktops']:
            if desktop['id'] == monitor['focusedDesktopId']:
                visit(desktop.get('root'))
    ordered = [wid for wid in state.get('stackingList', []) if wid in visible]
    return ordered + sorted(visible.difference(ordered))


def window_candidates():
    result = subprocess.run(['bspc', 'wm', '-d'], text=True, capture_output=True, check=True)
    return [window for wid in visible_window_ids(json.loads(result.stdout))
            if (window := GdkX11.X11Window.foreign_new_for_display(Gdk.Display.get_default(), wid)) is not None]


def window_rectangle(x, y, width, height, windows=None):
    for window in reversed(window_candidates() if windows is None else windows):
        wx, wy = window.get_origin()[-2:]
        if wx <= x < wx + window.get_width() and wy <= y < wy + window.get_height():
            return rectangle((wx, wy), (wx + window.get_width(), wy + window.get_height()), width, height)
    return None


class AreaSelector(Gtk.Window):
    def __init__(self, screenshot, mode='area'):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.image = screenshot
        self.mode = mode
        self.windows = window_candidates() if mode == 'window' else []
        self.hovered = None
        self.start = self.end = None
        self.selection = None
        self.set_decorated(False)
        self.set_accept_focus(True)
        self.set_app_paintable(True)
        # Keep selection pixels opaque: picom blurs translucent overlays,
        # making small text unreadable while selecting an OCR region.
        self.transparent = False
        self.set_visual(self.get_screen().get_system_visual())
        self.move(0, 0)
        self.resize(screenshot.get_width(), screenshot.get_height())
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                        Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.KEY_PRESS_MASK)
        self.connect('draw', self.draw)
        self.connect('button-press-event', self.press)
        self.connect('motion-notify-event', self.motion)
        self.connect('button-release-event', self.release)
        self.connect('key-press-event', self.key)
        self.connect('destroy', lambda *_: Gtk.main_quit())
        try:
            color = json.loads((HOME / '.config/desktop-themes/current.json').read_text())['colors']['accent']
        except (OSError, ValueError, KeyError):
            color = '#cba6f7'
        self.color = tuple(int(color[i:i+2], 16) / 255 for i in (1, 3, 5))

    def draw(self, _, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        if self.transparent:
            cr.set_source_rgba(0, 0, 0, 0)
            cr.paint()
        else:
            Gdk.cairo_set_source_pixbuf(cr, self.image, 0, 0)
            cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.set_source_rgba(0, 0, 0, .04)
        cr.paint()
        area = self.hovered if self.mode == 'window' else (
            rectangle(self.start, self.end, self.image.get_width(), self.image.get_height())
            if self.start is not None else None)
        if area is not None:
            x, y, width, height = area
            cr.save()
            cr.rectangle(x, y, width, height)
            cr.clip()
            if self.transparent:
                cr.set_operator(cairo.OPERATOR_CLEAR)
            else:
                Gdk.cairo_set_source_pixbuf(cr, self.image, 0, 0)
            cr.paint()
            cr.restore()
            cr.set_source_rgb(*self.color)
            cr.set_line_width(2)
            cr.rectangle(x, y, width, height)
            cr.stroke()
        return True

    def press(self, _, event):
        if event.button == 3:
            self.destroy()
        elif event.button == 1:
            self.start = self.end = (event.x_root, event.y_root)
            self.queue_draw()
        return True

    def motion(self, _, event):
        if self.mode == 'window':
            self.hovered = window_rectangle(event.x_root, event.y_root, self.image.get_width(), self.image.get_height(), self.windows)
            self.queue_draw()
        elif self.start is not None:
            self.end = (event.x_root, event.y_root)
            self.queue_draw()
        return True

    def release(self, _, event):
        if event.button == 1 and self.mode == 'window':
            self.selection = window_rectangle(event.x_root, event.y_root, self.image.get_width(), self.image.get_height(), self.windows)
            if self.selection is not None:
                self.destroy()
            return True
        if event.button == 1 and self.start is not None:
            selected = rectangle(self.start, (event.x_root, event.y_root), self.image.get_width(), self.image.get_height())
            if selected[2] > 1 and selected[3] > 1:
                self.selection = selected
            self.destroy()
        return True

    def key(self, _, event):
        if event.keyval == Gdk.KEY_Escape:
            self.destroy()
            return True
        return False

    def select(self):
        self.show_all()
        self.get_window().set_cursor(Gdk.Cursor.new_from_name(Gdk.Display.get_default(), 'crosshair'))
        self.get_window().focus(Gdk.CURRENT_TIME)
        seat = Gdk.Display.get_default().get_default_seat()
        seat.grab(self.get_window(), Gdk.SeatCapabilities.POINTER | Gdk.SeatCapabilities.KEYBOARD,
                  False, None, None, None, None)
        try:
            Gtk.main()
        finally:
            seat.ungrab()
        return self.selection


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else 'menu'
    if mode == 'menu':
        choices = {'Entire screen': 'screen', 'Select window': 'window', 'Select area': 'area'}
        result = subprocess.run([str(HOME / '.local/bin/desktop-menu'), '-p', 'Screenshot'],
                                input='\n'.join(choices) + '\n', capture_output=True, text=True)
        if result.returncode or result.stdout.strip() not in choices:
            return
        mode = choices[result.stdout.strip()]
    if mode not in ('screen', 'window', 'area'):
        raise ValueError('Choose screen, window or area')
    # Let the menu finish fading before reading screen pixels.
    time.sleep(.2)
    root = Gdk.get_default_root_window()
    if root is None:
        raise RuntimeError('Cannot access the X11 desktop')
    image = Gdk.pixbuf_get_from_window(root, 0, 0, root.get_width(), root.get_height())
    if image is None:
        raise RuntimeError('Could not capture the screen')
    if mode in ('area', 'window'):
        instruction = 'Click the window to capture.' if mode == 'window' else 'Drag over the area to capture.'
        notice = subprocess.run(['notify-send', '-p', '-t', '4000', '-h',
            'string:x-dunst-stack-tag:screenshot-select',
            'Select a window' if mode == 'window' else 'Select an area',
            instruction + ' Escape or right-click cancels.'], capture_output=True, text=True)
        selector = AreaSelector(image, mode)
        try:
            area = selector.select()
        finally:
            if notice.stdout.strip().isdigit():
                subprocess.run(['dunstctl', 'close', notice.stdout.strip()],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if area is None:
            return
        # Capture after the overlay and its instruction notification disappear.
        time.sleep(.35)
        image = Gdk.pixbuf_get_from_window(root, 0, 0, root.get_width(), root.get_height())
        if image is None:
            raise RuntimeError('Could not capture the selected region')
        image = image.new_subpixbuf(*area)
    directory = HOME / 'Pictures/Screenshots'
    directory.mkdir(parents=True, exist_ok=True)
    file = directory / (datetime.datetime.now().strftime('%Y-%m-%d_%H-%M-%S_%f') + '.png')
    image.savev(str(file), 'png', [], [])
    copied = False
    if shutil.which('xclip'):
        result = subprocess.run(['xclip', '-selection', 'clipboard', '-target', 'image/png', '-i', str(file)],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        copied = result.returncode == 0
    subprocess.run(['notify-send', '-i', str(file), 'Screenshot saved',
                    str(file) + ('\nCopied to clipboard.' if copied else '')], check=False)
    print(file)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'Screenshot failed: {error}', file=sys.stderr)
        subprocess.run(['notify-send', '-u', 'critical', 'Screenshot failed', str(error)], check=False)
        sys.exit(1)
