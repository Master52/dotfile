#!/bin/bash
# Select encrypted entry names only; pass handles decryption and clipboard guards.
umask 077
store=${PASSWORD_STORE_DIR:-$HOME/.password-store}
notify() { notify-send Passwords "$1"; }
if ! command -v pass >/dev/null || [[ ! -f "$store/.gpg-id" ]]; then
    notify 'Install pass and initialize it with your GPG key first.'
    exit 1
fi
entries=()
while IFS= read -r -d '' path; do
    entry=${path#"$store"/}; entry=${entry%.gpg}
    [[ "$entry" != .* && "$entry" != *$'\n'* ]] || continue
    entries+=("$entry")
done < <(find "$store" -type f -name '*.gpg' -print0 | sort -z)
if (( ${#entries[@]} == 0 )); then notify 'No passwords saved yet. Use pass insert to add one.'; exit 0; fi
selection=$(printf '%s\n' "${entries[@]}" | "$HOME/.local/bin/desktop-menu" -p 'Copy password') || exit 0
valid=false
for entry in "${entries[@]}"; do
    if [[ "$selection" == "$entry" ]]; then valid=true; break; fi
done
[[ "$valid" == true ]] || exit 0
if PASSWORD_STORE_CLIP_TIME=45 PASSWORD_STORE_X_SELECTION=clipboard \
    "$HOME/.local/bin/pass" show --clip "$selection" >/dev/null 2>&1; then
    notify 'Password copied. Paste with Ctrl+V; clipboard clears after 45 seconds.'
else
    notify 'Could not unlock or copy the selected password.'
    exit 1
fi
