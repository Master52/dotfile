#!/bin/sh
case "$DESKTOP_SXIV_MODE" in
 wallpaper) printf 'Wallpapers | Ctrl+x w: apply | Ctrl+x a: actions | %s x %s' "$2" "$3" ;;
 screenshots) printf 'Screenshots | Ctrl+x y: image | Ctrl+x p: path | Ctrl+x a: actions | %s x %s' "$2" "$3" ;;
 *) printf 'Ctrl+x a: actions | Ctrl+x p: copy path | %s x %s' "$2" "$3" ;;
esac
