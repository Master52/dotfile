/* Generated by desktop-theme. Edit the template, then switch themes. */
:root {
  --desktop-bg: {{bg}};
  --desktop-fg: {{fg}};
  --desktop-surface: {{surface}};
  --desktop-mantle: {{mantle}};
  --desktop-muted: {{muted}};
  --desktop-overlay: {{overlay}};
  --desktop-accent: {{accent}};
  --desktop-font: "{{ui_font}}", system-ui, sans-serif;
  --desktop-mode: {{mode}};
}
