#!/bin/bash
# Change brightness through the active local elogind session, without sudo.
. "$HOME/.local/libexec/desktop-backlight.sh"
fail() {
    printf '%s\n' "$1" >&2
    notify-send 'Brightness control failed' "$1" || :
    exit 1
}
case ${1:-} in up) direction=1 ;; down) direction=-1 ;; *) echo 'Usage: desktop-brightness {up|down}' >&2; exit 2 ;; esac
read_backlight || fail 'No display backlight found'
step=$(( (BACKLIGHT_MAX * 5 + 50) / 100 )); (( step > 0 )) || step=1
minimum=$(( (BACKLIGHT_MAX + 50) / 100 )); (( minimum > 0 )) || minimum=1
target=$(( BACKLIGHT_CURRENT + direction * step ))
(( target >= minimum )) || target=$minimum
(( target <= BACKLIGHT_MAX )) || target=$BACKLIGHT_MAX
sessions=$(timeout 4 loginctl list-sessions --no-legend) || fail 'Cannot list login sessions'
while read -r session_id session_uid rest; do
    [[ "$session_uid" == "$(id -u)" ]] || continue
    properties=$(timeout 4 loginctl show-session "$session_id" -p Active -p Remote) || continue
    grep -qx 'Active=yes' <<< "$properties" || continue
    grep -qx 'Remote=yes' <<< "$properties" && continue
    reply=$(timeout 4 busctl --system call org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager GetSession s "$session_id") || continue
    read -r signature session_path <<< "$reply"
    session_path=${session_path#\"}; session_path=${session_path%\"}
    [[ "$signature" == o && "$session_path" == /org/freedesktop/login1/session/* ]] || continue
    timeout 4 busctl --system call org.freedesktop.login1 "$session_path" \
        org.freedesktop.login1.Session SetBrightness ssu backlight "${BACKLIGHT_DEVICE##*/}" "$target" \
        >/dev/null || fail 'Could not change backlight brightness'
    printf 'Brightness: %s%%\n' "$(( (target * 100 + BACKLIGHT_MAX / 2) / BACKLIGHT_MAX ))"
    "$HOME/.local/bin/desktop-notify" brightness || :
    exit 0
done <<< "$sessions"
fail 'No active local login session found'
