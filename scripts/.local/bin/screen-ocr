#!/usr/bin/python3
"""Select a screen region, recognize English text, and copy it."""
import fcntl
import html
import importlib.machinery
import importlib.util
from pathlib import Path
import shutil
import subprocess
import tempfile
import time


def notify(title, body):
    subprocess.run(['notify-send', '-a', 'Screen OCR', '-t', '12000',
                    '--', title, html.escape(body)], check=False)


def recognize(engine, file):
    """Prepare small screen text and preserve the selected block's line order."""
    prepared = file.with_name('prepared.png')
    brightness = subprocess.run(
        ['magick', str(file), '-colorspace', 'Gray', '-format', '%[fx:mean]', 'info:'],
        capture_output=True, text=True, check=True)
    args = ['magick', str(file), '-colorspace', 'Gray', '-resize', '300%']
    if float(brightness.stdout) < .5:
        args.append('-negate')
    subprocess.run(args + ['-bordercolor', 'white', '-border', '20', str(prepared)],
                   capture_output=True, check=True)
    result = subprocess.run(
        [engine, str(prepared), 'stdout', '-l', 'eng', '--psm', '6'],
        capture_output=True, text=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or 'Text recognition failed')
    return result.stdout.strip()


def main():
    with open(Path.home() / '.cache/screen-ocr.lock', 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        engine = shutil.which('tesseract-ocr') or shutil.which('tesseract')
        if not engine:
            notify('OCR needs Tesseract',
                   'Run: sudo xbps-install -y tesseract-ocr tesseract-ocr-eng')
            return
        loader = importlib.machinery.SourceFileLoader(
            'screenshot_tool', str(Path.home() / '.local/bin/screenshot-tool'))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        screen = importlib.util.module_from_spec(spec)
        loader.exec_module(screen)
        time.sleep(.2)
        root = screen.Gdk.get_default_root_window()
        if root is None:
            raise RuntimeError('Cannot access the X11 desktop')
        image = screen.Gdk.pixbuf_get_from_window(
            root, 0, 0, root.get_width(), root.get_height())
        if image is None:
            raise RuntimeError('Cannot capture the screen')
        area = screen.AreaSelector(image).select()
        if area is None:
            return
        # Use the original pixels so selection borders cannot enter OCR.
        image = image.new_subpixbuf(*area)
        with tempfile.TemporaryDirectory(prefix='screen-ocr-') as directory:
            file = Path(directory) / 'area.png'
            image.savev(str(file), 'png', [], [])
            text = recognize(engine, file)
        if not text:
            notify('No text found', 'Try selecting a clearer or larger area.')
            return
        subprocess.run(['xclip', '-selection', 'clipboard'], input=text.encode(),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        notify('Text copied to clipboard', text)


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        notify('Screen OCR failed', str(error))
        raise SystemExit(1)
