#!/usr/bin/python3
"""Visual wallpaper and screenshot tools using sxiv's external key handler."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

HOME = Path.home()
CONFIG = HOME / '.config/sxiv-tools/config.json'
EXTENSIONS = {'.jpg', '.jpeg', '.png', '.webp', '.gif', '.bmp', '.tif', '.tiff', '.avif'}


def config():
    return json.loads(CONFIG.read_text())


def notify(title, body):
    subprocess.run(['notify-send', '-a', 'sxiv tools', title, body], check=False)


def images(roots, newest=False):
    found = set()
    for root in roots:
        root = Path(root).expanduser()
        if not root.is_dir():
            continue
        for file in root.rglob('*'):
            if file.is_file() and file.suffix.lower() in EXTENSIONS and '\n' not in str(file):
                found.add(file.resolve())
    if newest:
        return sorted(found, key=lambda p: p.stat().st_mtime_ns, reverse=True)
    return sorted(found, key=lambda p: str(p).casefold())


def editor_command(settings):
    editor = settings.get('editor', [])
    if not isinstance(editor, list) or any(not isinstance(s, str) for s in editor):
        raise ValueError('editor must be a JSON array, for example ["gimp"]')
    if editor:
        return editor if shutil.which(editor[0]) else None
    for app in ('gimp', 'pinta', 'krita', 'mtpaint'):
        if shutil.which(app):
            return [app]
    return None


def browse(kind, directory=None):
    settings = config()
    if directory:
        roots = [directory]
    elif kind == 'wallpaper':
        roots = settings['wallpaper_directories']
        if settings.get('include_theme_wallpapers', True):
            roots = [*roots, str(HOME / '.config/desktop-themes/themes')]
    else:
        roots = [settings['screenshot_directory']]
    files = images(roots, newest=kind == 'screenshots')
    if not files:
        notify('No images found', 'Add wallpapers to ~/Pictures/Wallpapers.' if kind == 'wallpaper'
               else 'Take a screenshot with Print Screen first.')
        return
    if not shutil.which('sxiv'):
        raise RuntimeError('sxiv is not installed.')
    env = dict(os.environ, DESKTOP_SXIV_MODE=kind)
    subprocess.run(['sxiv', '-t', '-i'], input=''.join(str(p) + '\n' for p in files),
                   text=True, env=env, check=True)


def copy_image(file):
    import gi
    gi.require_version('GdkPixbuf', '2.0')
    from gi.repository import GdkPixbuf
    if not shutil.which('xclip'):
        raise RuntimeError('xclip is required to copy images.')
    try:
        image = GdkPixbuf.Pixbuf.new_from_file(str(file))
    except Exception as error:
        raise ValueError(f'Cannot decode this image for the clipboard: {error}') from error
    with tempfile.TemporaryDirectory(prefix='sxiv-copy-') as temp:
        png = Path(temp) / 'clipboard.png'
        image.savev(str(png), 'png', [], [])
        subprocess.run(['xclip', '-selection', 'clipboard', '-target', 'image/png', '-i', str(png)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
    notify('Image copied', file.name + '\nPaste into an app that accepts images.\nFor the file path, use Ctrl+X then p.')


def copy_paths(files):
    if not shutil.which('xclip'):
        raise RuntimeError('xclip is required to copy paths.')
    payload = '\n'.join(str(file) for file in files)
    subprocess.run(['xclip', '-selection', 'clipboard', '-target', 'UTF8_STRING', '-i'],
                   input=payload, text=True, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, check=True)
    notify('File path copied' if len(files) == 1 else 'File paths copied',
           'Paste with Ctrl+V.\n' + (files[0].name if len(files) == 1 else f'{len(files)} marked files'))


def action(key, files):
    files = [Path(p).expanduser().resolve(strict=True) for p in files if p]
    files = [p for p in files if p.is_file()]
    if not files:
        return
    file = files[0]
    settings = config()
    if key == 'a':
        choices = {'Copy image to clipboard': 'y', 'Copy file path': 'p',
                   'Open containing folder': 'o', 'Image information': 'i',
                   'Print images': 'P'}
        if os.environ.get('DESKTOP_SXIV_MODE') == 'wallpaper':
            choices['Apply wallpaper and lock screen'] = 'w'
        if editor_command(settings):
            choices['Open in image editor'] = 'e'
        result = subprocess.run([str(HOME / '.local/bin/desktop-menu'), '-p', 'Image action'],
                                input='\n'.join(choices) + '\n', capture_output=True, text=True)
        if result.returncode or result.stdout.strip() not in choices:
            return
        key = choices[result.stdout.strip()]
    if key == 'w':
        notify('Updating wallpaper', file.name + '\nPreparing the matching lock screen…')
        subprocess.run([str(HOME / '.local/bin/desktop-theme'), '--set-wallpaper', str(file)], check=True)
        notify('Wallpaper and lock screen updated', 'Saved for the current theme: ' + file.name)
    elif key == 'y':
        copy_image(file)
    elif key in ('P', 'S-p'):
        subprocess.run(['gtklp', '-i', *map(str, files)], check=True)
    elif key == 'p':
        copy_paths(files)
    elif key == 'o':
        subprocess.run([str(HOME / '.local/bin/file-manager'), str(file.parent)], check=True)
    elif key == 'e':
        editor = editor_command(settings)
        if editor is None:
            raise RuntimeError('No image editor installed. Set editor in ~/.config/sxiv-tools/config.json, for example ["gimp"].')
        subprocess.Popen([*editor, *map(str, files)], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif key == 'i':
        import gi
        gi.require_version('GdkPixbuf', '2.0')
        from gi.repository import GdkPixbuf
        _, width, height = GdkPixbuf.Pixbuf.get_file_info(str(file))
        notify('Image information', f'{file.name}\n{width} × {height} pixels · {file.stat().st_size / 1024:.1f} KiB\n{file.parent}')


def main():
    if len(sys.argv) < 3:
        raise ValueError('Use: sxiv-tools browse wallpaper|screenshots [directory], or sxiv-tools action KEY')
    operation, arg = sys.argv[1:3]
    if operation == 'browse' and arg in ('wallpaper', 'screenshots'):
        browse(arg, sys.argv[3] if len(sys.argv) > 3 else None)
    elif operation == 'action':
        action(arg, sys.stdin.read().splitlines())
    else:
        raise ValueError('Unknown sxiv tool action.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'sxiv tools: {error}', file=sys.stderr)
        notify('Image action failed', str(error))
        sys.exit(1)
